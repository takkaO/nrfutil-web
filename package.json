{
  "name": "nrfutil-web",
  "version": "1.0.0",
  "description": "Flash nRF52 firmware from the browser using Web Serial — no drivers, no desktop app required",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/takkaO/nrfutil-web.git"
  },
  "homepage": "https://takkaO.github.io/nrfutil-web/",
  "bugs": {
    "url": "https://github.com/takkaO/nrfutil-web/issues"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build",
    "dev": "vite examples",
    "build:demo": "vite build examples --outDir ../demo --emptyOutDir --base ./"
  },
  "keywords": [
    "nrf52",
    "dfu",
    "nrfutil",
    "webserial",
    "firmware"
  ],
  "author": "takkaO",
  "license": "BSD-3-Clause",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": "24.16.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  },
  "dependencies": {
    "jszip": "3.10.1"
  }
}